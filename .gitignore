# Terraform working directory
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup*

# Terraform plan files
*.tfplan
tfplan

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json

# Terraform crash logs
crash.log
crash.*.log

# Terraform CLI config
.terraformrc
terraform.rc

# Local secret/environment files
.env
.env.*

# Temporary files
*.tmp